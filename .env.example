# Copy to .env and fill in. Never commit the real file.
# Variable names match what Scripts/App.py and Scripts/Index.py read.

AZURE_API_BASE=https://<your-resource>.openai.azure.com/
AZURE_API_KEY=

# Embedding deployment (the committed index was built with text-embedding-ada-002)
AZURE_EMBED_DEPLOYMENT=text-embedding-ada-002
AZURE_EMBED_VERSION=2023-05-15

# Chat deployment
AZURE_CHAT_DEPLOYMENT=
AZURE_CHAT_VERSION=
